<header class="global-header l-center">
	<a href="#main" class="skip-link">Skip to content</a>
	<div class="global-header__inner l-cluster">
		{% include '@DesignSystem/header-title.html.twig' %}
		<nav class="global-nav" aria-label="Main">
			<ul class="l-cluster clean-list">
				{% for item in navigation %}
					<li class="{% if item.active %}active{% endif %}"><a class="nav-link" href="{{ item.url }}">{{ item.label }}</a></li>
				{% endfor %}
			</ul>
		</nav>
	</div>
</header>