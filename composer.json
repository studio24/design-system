{
    "name": "studio24/design-system",
    "description": "Simple documentation-first tool to build a static design system website based on Markdown documentation files and Twig templates",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "twig/twig": "^3.0",
        "symfony/console": "^6.4|^7.1",
        "symfony/stopwatch": "^6.4|^7.1",
        "league/flysystem": "^3.3",
        "masterminds/html5": "^2.7",
        "league/commonmark": "^2.0"
    },
    "require-dev": {
        "overtrue/phplint": "^9.0",
        "phpunit/phpunit": ">=10.0",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "Studio24\\DesignSystem\\": "src"
        }
    },
    "bin": [
        "bin/design-system"
    ]
}
